# One JSON array on a single line. token = secret in the QR code URL (/m/<token>).
# Drink keys: espresso, ristretto, lungo, americano, cappuccino, latte, latte_macchiato, flat_white, macchiato
MACHINES=[{"slug":"paris-rdc","name":"Paris – RDC","token":"change-me-to-a-long-random-string","drinks":["espresso","lungo","cappuccino"]}]
# Host port and timezone used for displayed dates
PORT=3000
TZ=Europe/Paris
